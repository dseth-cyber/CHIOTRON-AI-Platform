POSTGRES_DB=chiotron_ai
POSTGRES_USER=chiotron_ai
POSTGRES_PASSWORD=change-me-before-production
AI_DATABASE_URL=postgres://chiotron_ai:change-me-before-production@postgres:5432/chiotron_ai?sslmode=disable
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
COMPUTE_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434

# Compute routing. Logical model ids are what callers ask for; the provider and
# upstream model name behind each one are configuration.
#   MODEL_ROUTES=logical=provider/model,logical=provider/model
MODEL_ROUTES=default=ollama/qwen2.5:0.5b
DEFAULT_MODEL=default
COMPUTE_TIMEOUT=120s
COMPUTE_HEALTH_TIMEOUT=5s

# Quota applied to a new API key when the creating call does not name one.
# Per-key limits are stored on the key record.
DEFAULT_RATE_LIMIT_PER_MINUTE=60

# Conversation policy. With PERSIST_PROMPTS=false a turn is still recorded so
# history keeps its shape, but the message text is not stored.
# HISTORY_TURN_LIMIT caps how many past turns are replayed to the model.
PERSIST_PROMPTS=true
HISTORY_TURN_LIMIT=20

# Knowledge platform. CLASSIFICATION_LEVELS is ordered least to most sensitive;
# an API key carries the highest level it may read.
STORAGE_ROOT=/var/lib/chiotron/documents
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
CLASSIFICATION_LEVELS=public,internal,confidential,restricted
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
MAX_DOCUMENT_BYTES=5242880
INGESTION_INTERVAL=5s
INGESTION_BATCH=4

# Agent planner. AGENT_MIN_SCORE is a reciprocal-rank-fusion score, which is
# small by construction: a single top-ranked hit contributes 1/(60+1).
AGENT_MAX_STEPS=3
AGENT_TOP_K=5
AGENT_MIN_SCORE=0.016
AGENT_CONFLICT_MARGIN=0.15

# Graph traversal. GRAPH_DEPTH is a ceiling a caller may lower but not raise.
GRAPH_DEPTH=2
GRAPH_MAX_NODES=60

# Control Plane runtime
VERSION=dev
HTTP_ADDR=:8080
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:5173
STARTUP_TIMEOUT=30s
SHUTDOWN_TIMEOUT=15s
READINESS_TIMEOUT=2s

# Observability. Prometheus scrapes /metrics with no extra configuration.
# Leave OTEL_EXPORTER_OTLP_ENDPOINT empty to run without trace export; set it
# to the existing collector (for example http://tempo:4318) to enable spans.
OTEL_SERVICE_NAME=ai-control-plane
DEPLOYMENT_ENVIRONMENT=development
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACES_SAMPLER_ARG=1.0

VITE_API_BASE_URL=http://localhost:8080
